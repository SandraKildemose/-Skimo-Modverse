# Netlify: læg i webroden. Lokalt (file:// eller simpel server) bruges disse ikke — derfor “virker det hjemme” men domænet opfører sig anderledes.

/*
  # Inline scripts findes på flere sider; faste sha256-lister knækker ved enhver lille ændring. Tillader derfor 'unsafe-inline' for script (stadig same-origin).
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests; block-all-mixed-content
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-Permitted-Cross-Domain-Policies: none
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(self), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), web-share=()

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# JS/CSS: ingen lang cache — browser/CDN skal spørge serveren hver gang (304 hvis uændret, 200 hvis du har uploadet nyt).
# Brug stadig ?v=… i HTML (deploy/apply-asset-version.sh) så URL ændres ved hvert release og gamle edges ikke kan levere gammel fil.
/assets/*
  Cache-Control: no-cache

/Guide/*
  Cache-Control: public, max-age=86400, must-revalidate

/NoCopyrightVid/*
  Cache-Control: public, max-age=86400, must-revalidate

/Videoer/*
  Cache-Control: public, max-age=86400, must-revalidate

/audio/*
  Cache-Control: public, max-age=86400, must-revalidate

/Modguards/*
  Cache-Control: public, max-age=86400
  X-Robots-Tag: noindex, noarchive, nosnippet
  Content-Disposition: attachment

/downloads/*
  Cache-Control: public, max-age=86400
  X-Robots-Tag: noindex, noarchive, nosnippet
  Content-Disposition: attachment
